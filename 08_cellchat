## =============================================================================
## 6. L-R bubble plots for selected consensus pathways
##    For each pathway / direction / neuronal population passing consensus,
##    all L-R pairs of that pathway are shown, using the values of the OLLC
##    state with higher pathway-level signaling. L-R values are averaged
##    across samples.
## =============================================================================
selected_pathways <- c("PTN", "EPHB", "NCAM", "CNTN", "NRG", "Glutamate", "PDGF")

get_pathway_map <- function(cc) {
  lrsig <- if (!is.null(cc@LR$LRsig)) cc@LR$LRsig else cc@DB$interaction
  data.frame(interaction_name = rownames(lrsig), pathway_name = lrsig$pathway_name,
             ligand = lrsig$ligand, receptor = lrsig$receptor, stringsAsFactors = FALSE)
}

extract_lr_edges <- function(cc, sample_id, genotype, direction) {
  prob <- cc@net$prob; pval <- cc@net$pval
  pmap <- get_pathway_map(cc)
  pmap <- pmap[pmap$interaction_name %in% dimnames(prob)[[3]] & pmap$pathway_name %in% selected_pathways, ]
  chosen <- chosen_ollc_for(genotype)
  neurons_present <- intersect(neuron_types, dimnames(prob)[[1]])
  if (nrow(pmap) == 0 || !(chosen %in% dimnames(prob)[[1]]) || length(neurons_present) == 0) return(NULL)
  bind_rows(lapply(seq_len(nrow(pmap)), function(i) {
    lr <- pmap$interaction_name[i]
    if (direction == "Neuron_to_OLLC") {
      p_vec <- prob[neurons_present, chosen, lr]; pv_vec <- pval[neurons_present, chosen, lr]
    } else {
      p_vec <- prob[chosen, neurons_present, lr]; pv_vec <- pval[chosen, neurons_present, lr]
    }
    data.frame(sample = sample_id, genotype = genotype, direction = direction,
               pathway = pmap$pathway_name[i], interaction_name = lr,
               lr_label = paste0(pmap$ligand[i], " - ", pmap$receptor[i]),
               neuronal_state = neurons_present,
               probability = as.numeric(p_vec), pval = as.numeric(pv_vec), stringsAsFactors = FALSE)
  }))
}

lr_edges <- bind_rows(lapply(seq_len(nrow(sample_design)), function(i) {
  cc <- read_cc(sample_design$sample[i])
  bind_rows(lapply(c("Neuron_to_OLLC", "OLLC_to_Neuron"), function(d)
    extract_lr_edges(cc, sample_design$sample[i], sample_design$genotype[i], d)))
}))

lr_final <- lr_edges %>%
  group_by(direction, pathway, interaction_name, lr_label, neuronal_state, genotype) %>%
  summarise(mean_prob = mean(probability, na.rm = TRUE), mean_pval = mean(pval, na.rm = TRUE),
            detection_frac = sum(probability > 0, na.rm = TRUE) / n(), .groups = "drop") %>%
  pivot_wider(id_cols = c(direction, pathway, interaction_name, lr_label, neuronal_state),
              names_from = genotype, values_from = c(mean_prob, mean_pval, detection_frac)) %>%
  inner_join(pathway_consensus %>%
               filter(passes_concordance, pathway %in% selected_pathways) %>%
               dplyr::select(direction, pathway, neuronal_state, effect_direction),
             by = c("direction", "pathway", "neuronal_state")) %>%
  mutate(eu_wins = effect_direction == "Euploid_ollc2_higher",
         winning_prob           = ifelse(eu_wins, mean_prob_euploid,      mean_prob_trisomic),
         winning_pval           = ifelse(eu_wins, mean_pval_euploid,      mean_pval_trisomic),
         winning_detection_frac = ifelse(eu_wins, detection_frac_euploid, detection_frac_trisomic),
         neg_log10_p = -log10(pmax(winning_pval, 1e-10)),
         winning_ollc_label = ifelse(eu_wins, "Eu_ollc_2", "T21_ollc_3"),
         source_target = ifelse(direction == "Neuron_to_OLLC",
                                paste0(neuronal_state, " -> ", winning_ollc_label),
                                paste0(winning_ollc_label, " -> ", neuronal_state))) %>%
  filter(!is.na(winning_prob), winning_prob > 0)

plot_lr_bubble <- function(df, direction_name, pathway_name) {
  plot_df <- filter(df, direction == direction_name, pathway == pathway_name)
  if (nrow(plot_df) == 0) return(invisible(NULL))
  x_levels <- unique(plot_df$source_target[order(match(plot_df$neuronal_state, neuron_types))])
  plot_df$source_target <- factor(plot_df$source_target, levels = x_levels)
  ggplot(plot_df, aes(x = source_target, y = lr_label, color = winning_prob,
                      size = neg_log10_p, alpha = winning_detection_frac)) +
    geom_point() +
    scale_color_gradient(low = "grey85", high = "#B2182B", name = "Communication\nprobability") +
    scale_size_continuous(name = expression(-log[10](p)), range = c(1.5, 7)) +
    scale_alpha_continuous(name = "Detected in\n(of matched samples)", range = c(0.35, 1), limits = c(0, 1)) +
    labs(x = NULL, y = "Ligand - Receptor",
         title = paste0(pathway_name, " pathway | ", gsub("_", " ", direction_name))) +
    theme_bw(base_size = 11) +
    theme(axis.text.x = element_text(angle = 45, hjust = 1), panel.grid.minor = element_blank(),
          plot.title = element_text(face = "bold"))
}

