## =============================================================================
## 2. CellChat per sample
## =============================================================================
run_cellchat <- function(obj, min.cells = 3) {

  obj$cellchat_celltypes <- as.character(obj$cellchat_celltypes)
  Idents(obj) <- "cellchat_celltypes"

  ## Ensembl -> symbol (one symbol per Ensembl ID)
  ens_ids <- rownames(obj)
  symbol_map <- AnnotationDbi::select(org.Hs.eg.db, keys = ens_ids, columns = "SYMBOL", keytype = "ENSEMBL")
  symbol_map <- symbol_map[!is.na(symbol_map$SYMBOL), , drop = FALSE]
  symbol_map <- symbol_map[!duplicated(symbol_map$ENSEMBL), , drop = FALSE]
  rownames(symbol_map) <- symbol_map$ENSEMBL

  obj <- subset(obj, features = intersect(ens_ids, rownames(symbol_map)))

  ## Log-normalized expression; Ensembl IDs mapping to the same symbol are summed
  expr <- GetAssayData(obj, assay = "RNA", layer = "data")
  rownames(expr) <- symbol_map[rownames(obj), "SYMBOL"]
  if (anyDuplicated(rownames(expr))) {
    expr <- rowsum(as.matrix(expr), group = rownames(expr), reorder = FALSE)
  }

  meta <- obj@meta.data[colnames(expr), , drop = FALSE]
  meta$samples <- unique(as.character(meta$sample))[1]

  cellchat <- createCellChat(object = expr, meta = meta, group.by = "cellchat_celltypes")
  cellchat@DB <- CellChatDB.human                    # full database
  cellchat <- subsetData(cellchat)
  cellchat <- identifyOverExpressedGenes(cellchat)
  cellchat <- identifyOverExpressedInteractions(cellchat)
  cellchat <- computeCommunProb(cellchat, population.size = FALSE)
  cellchat <- filterCommunication(cellchat, min.cells = min.cells)
  cellchat@options$min.cells <- min.cells
  cellchat@options$population.size <- FALSE
  cellchat <- computeCommunProbPathway(cellchat)
  cellchat <- aggregateNet(cellchat)
  cellchat <- netAnalysis_computeCentrality(cellchat)
  cellchat
}

for (s in sample_design$sample) {
  outfile <- file.path(cc_dir, paste0("cellchat_", s, ".rds"))
  if (file.exists(outfile)) next
  message("CellChat: ", s)
  sub_obj <- subset(entire, subset = sample == s)
  saveRDS(run_cellchat(sub_obj, min.cells = MIN_CELLS), outfile)
  rm(sub_obj); gc()
}

read_cc <- function(s) readRDS(file.path(cc_dir, paste0("cellchat_", s, ".rds")))
chosen_ollc_for <- function(genotype) if (genotype == "euploid") euploid_ollc else trisomic_ollc

## =============================================================================
## 3. Discrepancy plots
##    Per sample and neuronal population: number of retained LR interactions
##    (count) and total inferred communication strength (weight), in both
##    directions, involving OLLC_2 (euploid samples) or OLLC_3 (trisomic
##    samples). Interactions with the same direction of difference in
##    strength in at least half of the matched pairs are summarised by the
##    median across matched pairs, separately for OLLC_2 and OLLC_3.
## =============================================================================
extract_mature_ollc_edges <- function(cc, sample_id, genotype) {
  weight <- cc@net$weight; count <- cc@net$count
  chosen <- chosen_ollc_for(genotype)
  neuron_ids <- intersect(neuron_types, rownames(weight))
  if (length(neuron_ids) == 0 || !(chosen %in% rownames(weight))) return(NULL)
  rbind(
    data.frame(sample = sample_id, genotype = genotype, neuronal_state = neuron_ids,
               direction = "Neuron_to_OLLC",
               count = as.numeric(count[neuron_ids, chosen]), weight = as.numeric(weight[neuron_ids, chosen])),
    data.frame(sample = sample_id, genotype = genotype, neuronal_state = neuron_ids,
               direction = "OLLC_to_Neuron",
               count = as.numeric(count[chosen, neuron_ids]), weight = as.numeric(weight[chosen, neuron_ids]))
  )
}

count_weight <- bind_rows(lapply(seq_len(nrow(sample_design)), function(i) {
  extract_mature_ollc_edges(read_cc(sample_design$sample[i]), sample_design$sample[i], sample_design$genotype[i])
})) %>%
  left_join(dplyr::select(sample_design, sample, pair_id, genotype), by = c("sample", "genotype"))

## Matched-pair differences (trisomic OLLC_3 - euploid OLLC_2) in strength
count_weight_paired <- count_weight %>%
  pivot_wider(id_cols = c(pair_id, direction, neuronal_state),
              names_from = genotype, values_from = c(count, weight)) %>%
  filter(!is.na(weight_euploid), !is.na(weight_trisomic)) %>%
  mutate(diff_weight = weight_trisomic - weight_euploid)

discrepancy_summary <- count_weight_paired %>%
  group_by(direction, neuronal_state) %>%
  summarise(n_pairs_tested = n(),
            n_T21_higher = sum(diff_weight > 0),
            n_Eu_higher  = sum(diff_weight < 0),
            median_count_OLLC2  = median(count_euploid),
            median_count_OLLC3  = median(count_trisomic),
            median_weight_OLLC2 = median(weight_euploid),
            median_weight_OLLC3 = median(weight_trisomic),
            .groups = "drop") %>%
  mutate(n_consistent = pmax(n_T21_higher, n_Eu_higher),
         passes_half  = n_consistent >= n_pairs_tested / 2,
         support_label = paste0(n_consistent, "/", n_pairs_tested))
print(discrepancy_summary, n = Inf)

discrepancy_plot_df <- discrepancy_summary %>%
  filter(passes_half) %>%
