            by = c("direction", "pathway", "neuronal_state"))

plot_nodes  <- c("Eu_ollc_2", "T21_ollc_3", neuron_types)
node_colors <- c("Eu_ollc_2" = "#2166AC", "T21_ollc_3" = "#B2182B",
                 setNames(hcl.colors(length(neuron_types), palette = "Dynamic"), neuron_types))

plot_pathway_circle <- function(pw, dir) {
  tab <- filter(circle_summary, pathway == pw, direction == dir, passes_concordance)
  net <- matrix(0, length(plot_nodes), length(plot_nodes), dimnames = list(plot_nodes, plot_nodes))
  for (i in seq_len(nrow(tab))) {
    n <- tab$neuronal_state[i]
    if (dir == "Neuron_to_OLLC") {
      if (tab$median_Eu_probability[i]  > 0) net[n, "Eu_ollc_2"]  <- tab$median_Eu_probability[i]
      if (tab$median_T21_probability[i] > 0) net[n, "T21_ollc_3"] <- tab$median_T21_probability[i]
    } else {
      if (tab$median_Eu_probability[i]  > 0) net["Eu_ollc_2", n]  <- tab$median_Eu_probability[i]
      if (tab$median_T21_probability[i] > 0) net["T21_ollc_3", n] <- tab$median_T21_probability[i]
    }
  }
  if (sum(net > 0) == 0) return(invisible(NULL))
  par(mar = c(2, 2, 10, 2), xpd = TRUE)
  netVisual_circle(net = net, color.use = node_colors[rownames(net)],
                   title.name = paste0("PATHWAY: ", pw, " (", gsub("_", " ", dir), ")"),
                   vertex.weight = rep(18, length(plot_nodes)), vertex.weight.max = 18, vertex.size.max = 14,
                   vertex.label.cex = 0.60, vertex.label.color = "black",
                   edge.weight.max = max(net), edge.width.max = 10, weight.scale = TRUE,
                   alpha.edge = 0.72, label.edge = FALSE, edge.curved = 0.20,
                   arrow.width = 1, arrow.size = 0.24, remove.isolate = FALSE)
  legend("bottomleft", legend = c("Euploid mature OLLC: ollc_2", "Trisomic mature OLLC: ollc_3"),
         pch = 21, pt.bg = c("#2166AC", "#B2182B"), pt.cex = 1.7, bty = "n", cex = 0.85)
}

for (dir in c("OLLC_to_Neuron", "Neuron_to_OLLC")) {
  pws <- circle_summary %>% filter(direction == dir, passes_concordance) %>% pull(pathway) %>% unique() %>% sort()
  for (pw in pws) plot_pathway_circle(pw, dir)
}

