## =============================================================================
## 4. Paired pathway comparisons and consensus heatmaps
## =============================================================================
## Pathway probability (@netP$prob) between neurons and the genotype-matched
## OLLC state, in one direction
extract_pathway_prob <- function(cc, sample_id, genotype, direction, pathways = NULL) {
  pp <- cc@netP$prob
  pw_use <- if (is.null(pathways)) dimnames(pp)[[3]] else intersect(dimnames(pp)[[3]], pathways)
  if (length(pw_use) == 0) return(NULL)
  chosen <- chosen_ollc_for(genotype)
  if (direction == "Neuron_to_OLLC") {
    neurons_present <- intersect(neuron_types, dimnames(pp)[[1]])
    if (length(neurons_present) == 0 || !(chosen %in% dimnames(pp)[[2]])) return(NULL)
    edge_array <- pp[neurons_present, chosen, pw_use, drop = FALSE]
  } else {
    neurons_present <- intersect(neuron_types, dimnames(pp)[[2]])
    if (length(neurons_present) == 0 || !(chosen %in% dimnames(pp)[[1]])) return(NULL)
    edge_array <- pp[chosen, neurons_present, pw_use, drop = FALSE]
  }
  df <- expand.grid(neuronal_state = neurons_present, pathway = pw_use, stringsAsFactors = FALSE)
  df$probability <- as.numeric(edge_array)
  df$sample <- sample_id; df$genotype <- genotype; df$direction <- direction
  df
}

## Paired log2FC (OLLC_3 in trisomic / OLLC_2 in euploid); only where both values exist
make_paired <- function(edges) {
  edges %>%
    left_join(dplyr::select(sample_design, sample, pair_id, cell_line, modality, genotype),
              by = c("sample", "genotype")) %>%
    dplyr::select(pair_id, cell_line, modality, direction, pathway, neuronal_state, genotype, probability) %>%
    pivot_wider(id_cols = c(pair_id, cell_line, modality, direction, pathway, neuronal_state),
                names_from = genotype, values_from = probability) %>%
    mutate(log2FC_T21_vs_Eu = ifelse(!is.na(euploid) & !is.na(trisomic),
                                     log2((trisomic + EPS) / (euploid + EPS)), NA_real_))
}

## Consensus across matched pairs (zeros count; only missing values excluded)
make_consensus <- function(paired, min_concordance) {
  paired %>%
    filter(!is.na(log2FC_T21_vs_Eu)) %>%
    group_by(direction, pathway, neuronal_state) %>%
    summarise(n_pairs_tested = n(),
              n_T21_higher = sum(log2FC_T21_vs_Eu > 0, na.rm = TRUE),
              n_Eu_higher  = sum(log2FC_T21_vs_Eu < 0, na.rm = TRUE),
              median_log2FC_T21_vs_Eu = median(log2FC_T21_vs_Eu, na.rm = TRUE),
              .groups = "drop") %>%
    mutate(n_consistent = pmax(n_T21_higher, n_Eu_higher),
           passes_concordance = n_consistent >= min_concordance,
           effect_direction = case_when(n_T21_higher > n_Eu_higher ~ "T21_ollc3_higher",
                                        n_Eu_higher > n_T21_higher ~ "Euploid_ollc2_higher",
                                        TRUE ~ "mixed"),
           support_label = paste0(n_consistent, "/", n_pairs_tested),
           plot_effect = ifelse(passes_concordance, median_log2FC_T21_vs_Eu, NA_real_))
}

pathway_edges <- bind_rows(lapply(seq_len(nrow(sample_design)), function(i) {
  cc <- read_cc(sample_design$sample[i])
  bind_rows(lapply(c("Neuron_to_OLLC", "OLLC_to_Neuron"), function(d)
    extract_pathway_prob(cc, sample_design$sample[i], sample_design$genotype[i], d)))
}))
pathway_paired    <- make_paired(pathway_edges)
pathway_consensus <- make_consensus(pathway_paired, MIN_CONCORDANCE)
print(pathway_consensus %>% filter(passes_concordance), n = Inf)

## Heatmap: pathways with >= 1 consensus-supported neuronal population; tiles
## show median paired log2FC (coloured only when concordant) and support (n/N)
plot_consensus_heatmap <- function(consensus, dir, y_lab) {
  df <- filter(consensus, direction == dir)
  pathway_order <- df %>%
    filter(passes_concordance) %>%
    group_by(pathway) %>%
    summarise(max_abs_effect = max(abs(plot_effect), na.rm = TRUE), .groups = "drop") %>%
    arrange(desc(max_abs_effect)) %>%
    pull(pathway)
  df <- df %>%
    filter(pathway %in% pathway_order) %>%
    mutate(pathway = factor(pathway, levels = pathway_order),
           neuronal_state = factor(neuronal_state, levels = neuron_types))
  ggplot(df, aes(x = pathway, y = neuronal_state, fill = plot_effect)) +
    geom_tile(color = "grey80", linewidth = 0.25) +
    geom_text(aes(label = support_label), size = 3) +
    scale_fill_gradient2(low = "#2166AC", mid = "white", high = "#B2182B", midpoint = 0, na.value = "grey92",
                         name = expression("Median paired " * log[2] * "(T21 ollc_3 / Euploid ollc_2)")) +
    labs(x = "CellChat signaling pathway", y = y_lab) +
    theme_classic(base_size = 12) +
    theme(axis.text.x = element_text(angle = 45, hjust = 1, vjust = 1), axis.ticks = element_blank())
}
plot_consensus_heatmap(pathway_consensus, "Neuron_to_OLLC", "Neuronal sender population")
plot_consensus_heatmap(pathway_consensus, "OLLC_to_Neuron", "Neuronal receiver population")

